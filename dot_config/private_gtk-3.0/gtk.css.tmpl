/* Adwaita-dark con la paleta de Hyprland (Thunar y el resto de apps GTK3) */
@define-color theme_bg_color #{{ .palette.bg }};
@define-color theme_fg_color #{{ .palette.fg }};
@define-color theme_base_color #{{ .palette.bg }};
@define-color theme_text_color #{{ .palette.fg }};
@define-color theme_selected_bg_color #{{ .palette.accent }};
@define-color theme_selected_fg_color #{{ .palette.light }};
@define-color insensitive_fg_color #{{ .palette.gray }};
@define-color borders alpha(#{{ .palette.gray }}, 0.35);
@define-color unfocused_borders alpha(#{{ .palette.gray }}, 0.2);

window, .background, headerbar, .titlebar, toolbar, .sidebar, placessidebar, scrolledwindow, treeview, iconview, .view {
    background-color: #{{ .palette.bg }};
    color: #{{ .palette.fg }};
}

/* Barra lateral un tono por encima del fondo */
.sidebar, placessidebar list {
    background-color: #{{ .palette.bg_alt }};
}

*:selected, .view:selected, iconview:selected, row:selected {
    background-color: #{{ .palette.accent }};
    color: #{{ .palette.light }};
}

entry {
    background-color: #{{ .palette.bg_alt }};
    color: #{{ .palette.fg }};
    border-color: alpha(#{{ .palette.gray }}, 0.35);
}

button:hover, row:hover {
    background-color: alpha(#{{ .palette.accent2 }}, 0.35);
}

/* Sin foco (:backdrop) Adwaita aclara la ventana: mismos colores que con foco */
window:backdrop, .background:backdrop, headerbar:backdrop, .titlebar:backdrop, toolbar:backdrop,
scrolledwindow:backdrop, treeview:backdrop, iconview:backdrop, .view:backdrop {
    background-color: #{{ .palette.bg }};
    color: #{{ .palette.fg }};
}

/* Barra de menús (Archivo, Editar, Ver…), con y sin foco */
menubar, menubar:backdrop {
    background-color: #{{ .palette.bg }};
    color: #{{ .palette.fg }};
}

menubar > menuitem:hover {
    background-color: #{{ .palette.accent }};
    color: #{{ .palette.light }};
}

/* Menús desplegables y de clic derecho */
menu, .menu, .context-menu, menu:backdrop {
    background-color: #{{ .palette.bg }};
    color: #{{ .palette.fg }};
    border: 1px solid alpha(#{{ .palette.gray }}, 0.35);
}

menu menuitem {
    padding: 6px 10px;
}

menu menuitem:hover {
    background-color: #{{ .palette.accent }};
    color: #{{ .palette.light }};
}

menu menuitem:disabled, menu menuitem:disabled label {
    color: #{{ .palette.gray }};
}

menu separator {
    background-color: alpha(#{{ .palette.gray }}, 0.35);
}

/* wofi trae su propio estilo: su ventana queda transparente para que se vean las esquinas redondeadas */
#window, #window.background {
    background-color: transparent;
}
