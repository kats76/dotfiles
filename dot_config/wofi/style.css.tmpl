* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 13px;
}

/* La ventana queda transparente; el fondo redondeado va en #outer-box (si no, se ven las esquinas) */
window {
    margin: 0px;
    background-color: transparent;
}

#outer-box {
    margin: 0px;
    padding: 14px;
    border: 1px solid #{{ .palette.accent }};
    border-radius: 18px;
    background-color: alpha(#{{ .palette.bg }}, 0.96);
}

#input {
    margin: 0 0 12px 0;
    padding: 10px 14px;
    border: 1px solid #{{ .palette.neutral }};
    border-radius: 12px;
    background-color: #{{ .palette.bg }};
    color: #{{ .palette.fg }};
}

#input:focus {
    border-color: #{{ .palette.accent2 }};
}

#entry {
    padding: 10px 12px;
    border-radius: 12px;
    background-color: transparent;
    color: #{{ .palette.fg }};
}

#entry:selected {
    background-color: #{{ .palette.accent }};
    color: #{{ .palette.light }};
}

#text,
#text:selected {
    color: inherit;
}

#img {
    margin-right: 10px;
}
