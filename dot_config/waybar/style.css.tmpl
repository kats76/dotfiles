* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 12px;
}

@define-color bg #{{ .palette.bg }};
@define-color fg #{{ .palette.fg }};
@define-color accent #{{ .palette.accent }};
@define-color accent2 #{{ .palette.accent2 }};
@define-color red #{{ .palette.red }};
@define-color purple #{{ .palette.purple }};
@define-color neutral #{{ .palette.neutral }};
@define-color gray #{{ .palette.gray }};
@define-color light #{{ .palette.light }};

window#waybar {
    background-color: alpha(@bg, 0.82);
    color: @fg;
}

/* workspace bubbles */

#workspaces button {
    background: alpha(@bg, 0.95);
    color: @fg;

    padding: 4px 10px;
    margin: 6px 4px;

    border-radius: 10px;
}

#workspaces button.active {
    background: @accent;
    color: @light;
}

#workspaces button.urgent {
    background: @red;
    color: @light;
}

/* modules */
#clock,
#battery,
#cpu,
#memory,
#network,
#bluetooth,
#pulseaudio,
#backlight,
#tray {

    background: alpha(@bg, 0.95);
    color: @fg;

    padding: 4px 12px;
    margin: 6px 4px;

    border-radius: 10px;
    border: 1px solid alpha(@gray, 0.35);
}

/* hover animation */

#clock:hover,
#battery:hover,
#network:hover,
#bluetooth:hover,
#pulseaudio:hover {
    background: alpha(@accent2, 0.35);
}
