{
  "layer": "top",
  "position": "top",
  "height": 36,

  "modules-left": [
    "hyprland/workspaces",
  ],

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "pulseaudio",
    "backlight",
    "network",
    "bluetooth",
    "cpu",
    "memory",
    "battery",
    "clock",
    "tray"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true
  },

  "clock": {
    "format": " {:%H:%M}"
  },

  "network": {
    "interface": "wlan0",
    "format-wifi": " {signalStrength}%",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}\nClic: redes Wi-Fi",
    "tooltip-format-disconnected": "Sin conexión\nClic: redes Wi-Fi",
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "tooltip-format": "Bluetooth\nClic: dispositivos",
    "tooltip-format-connected": "{device_enumerate}\nClic: dispositivos",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "tooltip-format": "{desc}\nClic: volumen y salida · rueda: volumen",
    "on-click": "~/.config/waybar/scripts/sound-panel.py",
    "format-icons": {
      "default": ["","",""]
    }
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "󰃠 {percent}%"
  },

  "battery": {
    "battery": "BAT0",
    "adapter": "AC0",
    "tooltip-format": "{timeTo}\nClic: modo de energía",
    "on-click": "~/.config/waybar/scripts/power-menu.sh",
    "format": "{capacity}% {icon}",
    "format-icons": ["","","","",""]
  },

  "cpu": {
    "format": " {usage}%"
  },

  "memory": {
    "format": "󰍛 {}%"
  },

  "mpris": {
    "format": "{title} - {artist}",
    "format-paused": " {title}",
    "player-icons": {
        "spotify": "",
        "default": "🎵"
    },
    "max-length": 20
    }
}
