# Notificaciones con la identidad de Hyprland: salen bajo el título de la ventana de waybar
font=JetBrainsMono Nerd Font 10
background-color=#{{ .palette.bg }}f2
text-color=#{{ .palette.fg }}
border-color=#{{ .palette.accent }}
progress-color=over #{{ .palette.accent }}
border-size=2
border-radius=10
padding=10,14
width=420
height=160
icons=1
max-icon-size=32
max-visible=3
default-timeout=5000

# Pegadas a la barra, centradas como el título de la ventana
anchor=top-center
outer-margin=6,0,0,0
margin=6

[urgency=low]
border-color=#{{ .palette.gray }}

[urgency=critical]
border-color=#{{ .palette.red }}
default-timeout=0
