-------------------
---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
    hl.exec_cmd("hyprpaper")
    hl.exec_cmd("waybar")
    hl.exec_cmd("wal -i {{ .chezmoi.homeDir }}/Img/wallhaven-9oo8k1.jpg")
    hl.exec_cmd(lidScript)
end)

-- Equivalente al antiguo `exec =` (se ejecutaba en cada recarga)
hl.on("config.reloaded", function()
    hl.exec_cmd(lidScript)
end)


