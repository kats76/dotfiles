# Pantalla de bloqueo con la identidad del login de SDDM (sddm-silent/hypr.conf)
# Se abre con el botón Lock de wlogout y con hypridle (hypridle.conf)

$font = JetBrainsMono Nerd Font

general {
    hide_cursor = true
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 5, linear
    animation = fadeOut, 1, 5, linear
    animation = inputFieldDots, 1, 2, linear
}

# Wallpaper difuminado y oscurecido, como el login
background {
    monitor =
    path = {{ .chezmoi.homeDir }}/Img/wallhaven-9oo8k1.jpg
    color = rgba(1e1e2eff)
    blur_passes = 3
    blur_size = 8
    brightness = 0.6
}

# Reloj
label {
    monitor =
    text = $TIME
    color = rgba(cdd6f4ff)
    font_size = 96
    font_family = $font
    position = 0, -120
    halign = center
    valign = top
}

# Fecha en español (sigue el idioma del sistema)
label {
    monitor =
    text = cmd[update:60000] date +"%A, %-d de %B"
    color = rgba(6f9f98ff)
    font_size = 18
    font_family = $font
    position = 0, -260
    halign = center
    valign = top
}

# Contraseña: borde con el degradado de las ventanas (accent -> accent2)
input-field {
    monitor =
    size = 320, 52
    outline_thickness = 2
    rounding = 10
    inner_color = rgba(1e1e2ed9)
    outer_color = rgba(8a63c7ff) rgba(6f9f98ff) 45deg
    check_color = rgba(6f9f98ff)
    fail_color = rgba(c44532ff)
    capslock_color = rgba(8c6e6eff)
    font_color = rgba(cdd6f4ff)
    font_family = $font
    fade_on_empty = false
    placeholder_text = <span foreground="##a08f95">Contraseña…</span>
    fail_text = <span foreground="##c44532">$PAMFAIL</span>
    dots_spacing = 0.3
    position = 0, -40
    halign = center
    valign = center
}
