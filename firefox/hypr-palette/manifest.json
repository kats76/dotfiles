{
  "manifest_version": 2,
  "name": "Hypr Palette",
  "version": "1.0.0",
  "description": "Paleta del escritorio Hyprland de kats76/dotfiles: fondo #1e1e2e, acento #8a63c7, texto #cdd6f4.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hypr-palette@kats76.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#1e1e2e",
      "frame_inactive": "#1e1e2e",
      "tab_background_text": "#a08f95",
      "tab_selected": "#8a63c7",
      "tab_text": "#c7ced6",
      "tab_line": "#8a63c7",
      "tab_loading": "#6f9f98",
      "tab_background_separator": "rgba(160, 143, 149, 0.35)",

      "toolbar": "#1e1e2e",
      "toolbar_text": "#cdd6f4",
      "toolbar_top_separator": "#1e1e2e",
      "toolbar_bottom_separator": "rgba(160, 143, 149, 0.35)",
      "toolbar_vertical_separator": "rgba(160, 143, 149, 0.35)",
      "icons": "#cdd6f4",
      "icons_attention": "#6f9f98",
      "button_background_hover": "rgba(111, 159, 152, 0.35)",
      "button_background_active": "rgba(138, 99, 199, 0.5)",

      "toolbar_field": "#252536",
      "toolbar_field_text": "#cdd6f4",
      "toolbar_field_border": "rgba(160, 143, 149, 0.35)",
      "toolbar_field_focus": "#1e1e2e",
      "toolbar_field_text_focus": "#cdd6f4",
      "toolbar_field_border_focus": "#6f9f98",
      "toolbar_field_highlight": "#8a63c7",
      "toolbar_field_highlight_text": "#c7ced6",

      "popup": "#1e1e2e",
      "popup_text": "#cdd6f4",
      "popup_border": "#8a63c7",
      "popup_highlight": "#8a63c7",
      "popup_highlight_text": "#c7ced6",

      "sidebar": "#1e1e2e",
      "sidebar_text": "#cdd6f4",
      "sidebar_border": "rgba(160, 143, 149, 0.35)",
      "sidebar_highlight": "#8a63c7",
      "sidebar_highlight_text": "#c7ced6",

      "ntp_background": "#1e1e2e",
      "ntp_text": "#cdd6f4"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
