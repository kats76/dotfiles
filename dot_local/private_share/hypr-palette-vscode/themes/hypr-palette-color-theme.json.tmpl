  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#9399b2", "fontStyle": "italic" } },
    { "scope": ["comment.block.documentation", "comment.line.double-slash.documentation"], "settings": { "foreground": "#9399b2", "fontStyle": "italic" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#f5c2e7" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#fab387" } },
    { "scope": ["constant.language", "constant.language.boolean", "constant.language.null"], "settings": { "foreground": "#fab387" } },
    { "scope": ["constant.other", "variable.other.constant"], "settings": { "foreground": "#fab387" } },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#cba6f7" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "#89dceb" } },
    { "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"], "settings": { "foreground": "#cba6f7" } },
    { "scope": ["meta.preprocessor", "keyword.preprocessor", "punctuation.separator.hash"], "settings": { "foreground": "#f5c2e7" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["entity.name.type.interface"], "settings": { "foreground": "#f9e2af", "fontStyle": "italic" } },
    { "scope": ["entity.name.type.enum"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["variable.other.enummember", "constant.other.enum"], "settings": { "foreground": "#94e2d5" } },
    { "scope": ["entity.name.type.namespace", "entity.name.namespace"], "settings": { "foreground": "#f9e2af", "fontStyle": "italic" } },
    { "scope": ["variable.parameter", "entity.name.variable.parameter"], "settings": { "foreground": "#eba0ac", "fontStyle": "italic" } },
    { "scope": ["variable", "entity.name.variable"], "settings": { "foreground": "#{{ .palette.fg }}" } },
    { "scope": ["variable.language.this", "variable.language.self", "variable.language.base"], "settings": { "foreground": "#f38ba8", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "entity.name.variable.property", "entity.name.variable.field", "support.variable.property"], "settings": { "foreground": "#b4befe" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f9e2af", "fontStyle": "italic" } },
    { "scope": ["storage.type.attribute", "meta.attribute"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#9399b2" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#cba6f7", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f38ba8" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f38ba8" } }
  ],
  "semanticTokenColors": {
    "namespace": { "foreground": "#f9e2af", "italic": true },
    "class": "#f9e2af",
    "struct": "#f9e2af",
